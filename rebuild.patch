-function normalizePath(pathname) {
-  return (pathname || '/')
-    .replace(/^\/+/, '')
-    .replace(/\/+$/, '')
-    .toLowerCase();
-}
-
-function pageFromLocation() {
-  // GitHub Pages fallback support: 404.html redirects /website to /?page=website,
-  // then this function restores the clean /website URL.
-  const params = new URLSearchParams(window.location.search);
-  const queryPage = params.get('page');
-  if (queryPage && pages.includes(queryPage)) return queryPage;
-
-  const path = normalizePath(window.location.pathname);
-  if (!path) return 'home';
-  return pages.includes(path) ? path : 'home';
-}
-
-function setCleanUrl(id, replace = false) {
-  const nextPath = pathForPage(id);
-  const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
-  const hasExtra = window.location.search || window.location.hash;
-
-  if (currentPath !== nextPath || hasExtra) {
-    const method = replace ? 'replaceState' : 'pushState';
-    history[method](null, '', nextPath);
-  }
-}
